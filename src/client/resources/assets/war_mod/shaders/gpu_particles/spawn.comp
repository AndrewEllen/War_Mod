#version 430 core
layout(local_size_x = 64) in;

struct Particle {
    vec4 position_age;
    vec4 velocity_lifetime;
    vec4 colour_size;
    vec4 orientation_mode;
    uvec4 metadata;
};
struct Emitter {
    vec4 position_scale;
    vec4 velocity_lifetime;
    vec4 colour;
    vec4 parameters;
    vec4 orientation_mode;
    uvec4 metadata;
};

layout(std430, binding = 0) buffer ParticleBuffer { Particle particles[]; };
layout(std430, binding = 1) readonly buffer EmitterBuffer { Emitter emitters[]; };
layout(std430, binding = 4) buffer DeadList { uint deadCount; uint deadIds[]; };
layout(std430, binding = 6) buffer AliveOutput {
    uint outputAliveCount;
    uint outputAliveIds[];
};
layout(std430, binding = 7) buffer StatsBuffer { uint stats[]; };
uniform uint particleCapacity;
uniform uint particleTypeCount;
uniform uint visualLayerCount;
uniform uint emitterCount;
uniform uint spawnEpoch;

uint hash32(uint value) {
    value ^= value >> 16;
    value *= 0x7feb352du;
    value ^= value >> 15;
    value *= 0x846ca68bu;
    return value ^ (value >> 16);
}
float unit(uint value) { return float(hash32(value)) / 4294967295.0; }

bool popDead(out uint particleId) {
    uint available = atomicAdd(deadCount, 0u);
    while (available > 0u) {
        uint previous = atomicCompSwap(deadCount, available, available - 1u);
        if (previous == available) {
            particleId = deadIds[available - 1u];
            return particleId < particleCapacity;
        }
        available = previous;
    }
    return false;
}

void main() {
    uint emitterId = gl_WorkGroupID.x;
    uint lane = gl_LocalInvocationID.x;
    if (emitterId >= emitterCount) return;
    Emitter emitter = emitters[emitterId];
    uint spawnCount = min(emitter.metadata.x, 64u);
    if (lane >= spawnCount) return;
    uint type = min(emitter.metadata.z, particleTypeCount - 1u);
    uint layer = min(emitter.metadata.w >> 16u, visualLayerCount - 1u);
    uint layerStatsBase = particleTypeCount * 4u + 4u;
    uint slot;
    if (!popDead(slot)) {
        atomicAdd(stats[particleTypeCount * 2u + type], 1u);
        atomicAdd(stats[layerStatsBase + visualLayerCount * 2u + layer], 1u);
        return;
    }
    uint seed = emitter.metadata.y ^ hash32(lane + emitterId * 131u)
        ^ hash32(spawnEpoch * 0x9e3779b9u);
    float angle = unit(seed) * 6.28318530718;
    float radius = sqrt(unit(seed ^ 0x9e3779b9u)) * emitter.parameters.y;
    float vertical = (unit(seed ^ 0x85ebca6bu) - 0.35) * emitter.parameters.y * 0.45;
    vec3 offset = vec3(cos(angle) * radius, vertical, sin(angle) * radius);
    uint flags = emitter.metadata.w & 0xffffu;
    if ((flags & 1u) != 0u) {
        vec3 normal = normalize(emitter.orientation_mode.xyz);
        vec3 reference = abs(normal.y) > 0.92
            ? vec3(1.0, 0.0, 0.0) : vec3(0.0, 1.0, 0.0);
        vec3 tangent = normalize(cross(reference, normal));
        vec3 bitangent = normalize(cross(normal, tangent));
        offset = tangent * (cos(angle) * radius)
            + bitangent * (sin(angle) * radius) + normal * vertical;
    }
    vec3 jitter = vec3(unit(seed ^ 0xc2b2ae35u) - 0.5,
        unit(seed ^ 0x27d4eb2fu), unit(seed ^ 0x165667b1u) - 0.5);
    particles[slot].position_age = vec4(emitter.position_scale.xyz + offset, 0.0);
    particles[slot].velocity_lifetime = vec4(emitter.velocity_lifetime.xyz
        + jitter * emitter.parameters.z, max(0.05, emitter.velocity_lifetime.w
        * mix(0.75, 1.25, unit(seed ^ 0xd3a2646cu))));
    particles[slot].colour_size = vec4(emitter.colour.rgb,
        emitter.parameters.x * mix(0.72, 1.28, unit(seed ^ 0xfd7046c5u)));
    particles[slot].orientation_mode = emitter.orientation_mode;
    particles[slot].metadata = uvec4(type, seed,
        emitter.metadata.w, floatBitsToUint(emitter.colour.a));
    uint outputIndex = atomicAdd(outputAliveCount, 1u);
    if (outputIndex < particleCapacity) outputAliveIds[outputIndex] = slot;
    atomicAdd(stats[type], 1u);
    atomicAdd(stats[particleTypeCount + type], 1u);
    atomicAdd(stats[layerStatsBase + layer], 1u);
    atomicAdd(stats[layerStatsBase + visualLayerCount + layer], 1u);
}
