#version 430 core
layout(local_size_x = 256) in;

struct Particle {
    vec4 position_age;
    vec4 velocity_lifetime;
    vec4 colour_size;
    uvec4 metadata;
};
layout(std430, binding = 0) readonly buffer ParticleBuffer { Particle particles[]; };
layout(std430, binding = 2) buffer VisibleBuffer { uint visibleIds[]; };
layout(std430, binding = 3) buffer DrawCommand {
    uint vertexCount;
    uint instanceCount;
    uint firstVertex;
    uint baseInstance;
};
uniform uint particleCapacity;
uniform mat4 viewProjection;
uniform vec3 cameraPosition;

void main() {
    uint id = gl_GlobalInvocationID.x;
    if (id >= particleCapacity) return;
    Particle particle = particles[id];
    float lifetime = particle.velocity_lifetime.w;
    if (lifetime <= 0.0 || particle.position_age.w >= lifetime) return;
    vec3 relative = particle.position_age.xyz - cameraPosition;
    float distanceSquared = dot(relative, relative);
    if (distanceSquared > 2359296.0) return;
    vec4 clip = viewProjection * vec4(relative, 1.0);
    float allowance = max(0.015, particle.colour_size.w / max(1.0, sqrt(distanceSquared)));
    if (clip.w <= 0.0 || abs(clip.x) > clip.w * (1.0 + allowance)
        || abs(clip.y) > clip.w * (1.0 + allowance)
        || clip.z < -clip.w || clip.z > clip.w) return;
    uint outputIndex = atomicAdd(instanceCount, 1u);
    if (outputIndex < particleCapacity) visibleIds[outputIndex] = id;
}
