#version 430 core
layout(local_size_x = 256) in;

struct Particle {
    vec4 position_age;
    vec4 velocity_lifetime;
    vec4 colour_size;
    uvec4 metadata;
};
layout(std430, binding = 0) readonly buffer ParticleBuffer { Particle particles[]; };
layout(std430, binding = 2) buffer VisibleBuffer { uint visibleIds[]; };
struct DrawCommand {
    uint vertexCount;
    uint instanceCount;
    uint firstVertex;
    uint baseInstance;
};
layout(std430, binding = 3) buffer DrawCommands { DrawCommand commands[]; };
layout(std430, binding = 6) readonly buffer AliveInput {
    uint aliveCount;
    uint aliveIds[];
};
layout(std430, binding = 7) buffer StatsBuffer { uint stats[]; };
uniform uint particleCapacity;
uniform uint particleTypeCount;
uniform mat4 viewProjection;
uniform vec3 cameraPosition;
uniform float viewportHeight;
uniform float projectionScale;

uint hash32(uint value) {
    value ^= value >> 16;
    value *= 0x7feb352du;
    value ^= value >> 15;
    value *= 0x846ca68bu;
    return value ^ (value >> 16);
}

void main() {
    uint aliveIndex = gl_GlobalInvocationID.x;
    if (aliveIndex >= aliveCount) return;
    uint id = aliveIds[aliveIndex];
    if (id >= particleCapacity) return;
    Particle particle = particles[id];
    uint type = min(particle.metadata.x, particleTypeCount - 1u);
    vec3 relative = particle.position_age.xyz - cameraPosition;
    float distanceSquared = dot(relative, relative);
    if (distanceSquared > 2359296.0) {
        atomicAdd(stats[particleTypeCount * 4u], 1u);
        return;
    }
    float distance = max(0.25, sqrt(distanceSquared));
    float projectedDiameter = particle.colour_size.w * 2.0
        * projectionScale * viewportHeight * 0.5 / distance;
    float minimumPixels = type == 2u ? 0.18 : 0.42;
    if (projectedDiameter < minimumPixels) {
        float keep = clamp(projectedDiameter / minimumPixels, 0.02, 1.0);
        float stable = float(hash32(id ^ particle.metadata.y)) / 4294967295.0;
        if (stable > keep) {
            atomicAdd(stats[particleTypeCount * 4u + 1u], 1u);
            return;
        }
    }
    vec4 clip = viewProjection * vec4(relative, 1.0);
    float allowance = max(0.015, particle.colour_size.w / max(1.0, distance));
    if (clip.w <= 0.0 || abs(clip.x) > clip.w * (1.0 + allowance)
        || abs(clip.y) > clip.w * (1.0 + allowance)
        || clip.z < -clip.w || clip.z > clip.w) {
        atomicAdd(stats[particleTypeCount * 4u + 2u], 1u);
        return;
    }
    uint outputIndex = atomicAdd(commands[type].instanceCount, 1u);
    if (outputIndex < particleCapacity) {
        visibleIds[type * particleCapacity + outputIndex] = id;
        atomicAdd(stats[particleTypeCount * 3u + type], 1u);
    }
}
