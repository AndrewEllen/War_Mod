{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "java",
      "name": "Minecraft Client",
      "request": "launch",
      "cwd": "${workspaceFolder}/run",
      "preLaunchTask": "war_mod: prepare debug outputs",
      "console": "integratedTerminal",
      "stopOnEntry": false,
      "mainClass": "net.fabricmc.devlaunchinjector.Main",
      "vmArgs": [
        "-Dfabric.dli.config=${workspaceFolder}/.gradle/loom-cache/launch.cfg",
        "-Dfabric.dli.env=client",
        "-Dfabric.dli.main=net.fabricmc.loader.impl.launch.knot.KnotClient",
        "--sun-misc-unsafe-memory-access=allow",
        "--enable-native-access=ALL-UNNAMED"
      ],
      "args": "",
      "classPaths": [
        "$Auto",
        "!${workspaceFolder}/bin/main",
        "!${workspaceFolder}/bin/client",
        "!${workspaceFolder}/bin/test",
        "${workspaceFolder}/build/classes/java/main",
        "${workspaceFolder}/build/resources/main",
        "${workspaceFolder}/build/classes/java/client",
        "${workspaceFolder}/build/resources/client"
      ],
      "shortenCommandLine": "argfile"
    },
    {
      "type": "java",
      "name": "Minecraft Server",
      "request": "launch",
      "cwd": "${workspaceFolder}/run",
      "preLaunchTask": "war_mod: prepare debug outputs",
      "console": "integratedTerminal",
      "stopOnEntry": false,
      "mainClass": "net.fabricmc.devlaunchinjector.Main",
      "vmArgs": [
        "-Dfabric.dli.config=${workspaceFolder}/.gradle/loom-cache/launch.cfg",
        "-Dfabric.dli.env=server",
        "-Dfabric.dli.main=net.fabricmc.loader.impl.launch.knot.KnotServer",
        "--sun-misc-unsafe-memory-access=allow",
        "--enable-native-access=ALL-UNNAMED"
      ],
      "args": "nogui",
      "classPaths": [
        "$Auto",
        "!${workspaceFolder}/bin/main",
        "!${workspaceFolder}/bin/client",
        "!${workspaceFolder}/bin/test",
        "${workspaceFolder}/build/classes/java/main",
        "${workspaceFolder}/build/resources/main",
        "${workspaceFolder}/build/classes/java/client",
        "${workspaceFolder}/build/resources/client"
      ],
      "shortenCommandLine": "argfile"
    }
  ]
}
